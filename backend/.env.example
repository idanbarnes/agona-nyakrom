# ─────────────────────────────────────────
# Server Configuration (Example)
# ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
TRUST_PROXY=false
DATABASE_URL=

# ─────────────────────────────────────────
# PostgreSQL Database Configuration (Example)
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_NAME=your_database_name
DB_SSL=false

# ─────────────────────────────────────────
# Security Settings (Example)
# ─────────────────────────────────────────
JWT_SECRET=YOUR_SECRET_KEY_HERE
PREVIEW_TOKEN_SECRET=YOUR_PREVIEW_SECRET_KEY_HERE
JWT_EXPIRES_IN=1d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_FOR_FIRST_ADMIN_SETUP
ALLOW_ADMIN_BOOTSTRAP_WHEN_ADMINS_EXIST=false
ADMIN_PASSWORD_MIN_LENGTH=10

# Public frontend origin for admin preview URLs
# Canonical public site origin. Production must be the final HTTPS domain.
SITE_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5174
ADMIN_SITE_URL=http://localhost:5173
UNIFIED_SITE_URL=
PUBLIC_ASSET_BASE_URL=http://localhost:5000
PUBLIC_SHARE_IMAGE_URL=http://localhost:5174/share-default.svg
PUBLIC_LOGO_URL=
PUBLIC_SOCIAL_PROFILES=

# Visitor analytics. Development can enable this explicitly; production should
# set ANALYTICS_ENABLED=true after the migration is applied.
ANALYTICS_ENABLED=false
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_MAX_PAYLOAD_BYTES=4096
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000
ANALYTICS_RATE_LIMIT_MAX_EVENTS=60
ANALYTICS_DEDUPE_WINDOW_MS=10000
ANALYTICS_ADMIN_MAX_RANGE_DAYS=180
ANALYTICS_RECENT_WINDOW_MINUTES=30
ANALYTICS_ADMIN_REFRESH_SECONDS=60

# ─────────────────────────────────────────
# File Upload Settings (Example)
# ─────────────────────────────────────────
MEDIA_STORAGE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
# Production defaults to Cloudinary when MEDIA_STORAGE is omitted.
# Set this only if you knowingly accept ephemeral local production uploads.
ALLOW_PRODUCTION_LOCAL_UPLOADS=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=agonanyakrom
